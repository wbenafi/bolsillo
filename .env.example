NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CLERK_JWT_ISSUER_DOMAIN=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGN_TTL_SECONDS=300
# Solo para Convex local + MinIO (npm run dev:local). No configurar en cloud.
# R2_LOCAL_ENDPOINT=http://127.0.0.1:9000
# Para probar desde otro equipo, configurar en Convex el origen público de MinIO.
# R2_LOCAL_PUBLIC_ENDPOINT=http://wbox.local:9000
# Para acceder a MinIO por el puerto de Next (solo desarrollo):
# En .env.local, destino interno del proxy de Next:
# LOCAL_STORAGE_PROXY_TARGET=http://127.0.0.1:9000
# En las variables del backend Convex, URL visible desde el navegador:
# R2_LOCAL_PROXY_URL=http://wbox.local:3000/__files
# El proxy tiene prioridad sobre R2_LOCAL_PUBLIC_ENDPOINT.

# Lectura de comprobantes. Configurar SOLO en el backend Convex, nunca NEXT_PUBLIC.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Tarifas USD por millón de tokens de tu endpoint. Opcionales: sin ellas el costo
# aparece como no disponible; tokens, análisis y errores siguen registrándose.
QWEN_INPUT_USD_PER_MILLION=
QWEN_OUTPUT_USD_PER_MILLION=
